# Public Supabase client credentials (set in Vercel Environment Variables and local .env.local)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Local-only credential for running `npm run seed:supabase` (NEVER prefix with VITE_ or commit)
SUPABASE_SERVICE_ROLE_KEY=your-local-only-service-role-key
